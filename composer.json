{
    "name": "aimalazmi/omnipay-wgop",
    "description": "Omnipay driver for ANZ Worldline Global Online Pay (WGOP)",
    "keywords": ["omnipay", "wgop", "worldline", "anz", "payment", "gateway"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Aimal Azmi",
            "email": "aimal.azmi.13@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "omnipay/common": "~3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "php-http/guzzle7-adapter": "^1.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Omnipay\\WGOP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\WGOP\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
